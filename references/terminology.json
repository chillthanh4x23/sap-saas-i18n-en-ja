          "id": "post-posting-posted",
          "source": "Post / Posting / Posted",
          "japanese": "転記 / 転記 / 転記済み for ERP accounting; 投稿 for a publication/social action",
          "notes": "Do not infer accounting from the word Post alone.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "Post",
              "Posting",
              "Posted"
            ],
            "match": "phrase",
            "severity": "warning"
          }
        },
        {
          "id": "available",
          "source": "Available",
          "japanese": "利用可能 for a usable feature; 空き for capacity; 在庫あり for stock; 件見つかりました for search results where appropriate",
          "notes": "Preserve the real proposition. “No results available” is usually 該当する結果がありません.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "Available"
            ],
            "match": "phrase",
            "severity": "warning"
          }
        },
        {
          "id": "successfully",
          "source": "Successfully",
          "japanese": "Compact completed-result wording for controls/statuses; natural polite completed-result sentences for message bodies; 正常に when normal execution itself matters",
          "notes": "Preserve completed success, distinct from action/progress. Do not mechanically insert 正常に. Follow ui-writing.md: headings compact, message bodies polite, hints clipped."
        },
        {
          "id": "submit",
          "source": "Submit",
          "japanese": "送信 for sending a request; 提出 when the business process requires formal submission",
          "notes": "Choose by the actual request flow: sending a request and formally submitting a business document can require different wording.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "Submit"
            ],
            "match": "phrase",
            "severity": "warning"
          }
        },
        {
          "id": "tenant-workspace-organization",
          "source": "Tenant / Workspace / Organization",
          "japanese": "テナント / ワークスペース / 組織",
          "notes": "Keep distinct unless the product explicitly defines them as the same entity."
        },
        {
          "id": "role-permission-authorization-authentication",
          "source": "Role / Permission / Authorization / Authentication",
          "japanese": "ロール / 権限 / 認可 / 認証",
          "notes": "Preserve the security meaning. Do not conflate logging in with being allowed to perform an action."
        },
        {
          "id": "subscription",
          "source": "Subscription",
          "japanese": "サブスクリプション for a SaaS plan/service; 購読 for a feed/newsletter where appropriate",
          "notes": "Billing cancellation does not necessarily delete an account or data.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "Subscription"
            ],
            "match": "phrase",
            "severity": "warning"
          }
        },
        {
          "id": "deploy-publish-release",
          "source": "Deploy / Publish / Release",
          "japanese": "デプロイ / 公開 / リリース",
          "notes": "These operations may have different effects. Use the actual product workflow."
        }
      ],
      "after": [
        "For unresolved context decisions, give a proposed interpretation and explain it in the user's language. If business meaning is uncertain, retain pending status and ask about the operation. A stylistic preference can be proposed and recorded without forcing a non-Japanese-speaking user to choose synonyms."
      ]
    },
