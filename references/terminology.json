        {
          "id": "supplier-vendor",
          "source": "Supplier / Vendor",
          "japanese": "仕入先 for an SAP ERP supplier role; サプライヤー for a SaaS/product convention",
          "notes": "Context decision. Preserve the application's agreed form, including サプライヤ if the linked SAP product uses that spelling. A convention for one application does not govern another.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "Supplier",
              "Vendor"
            ],
            "match": "phrase",
            "severity": "warning"
          }
        },
        {
          "id": "customer",
          "source": "Customer",
          "japanese": "得意先 for SAP sales/accounting customer master; 顧客 for general SaaS customers; カスタマー if already agreed",
          "notes": "Context decision. A customer record and a tenant organization are not interchangeable.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "Customer"
            ],
            "match": "phrase",
            "severity": "warning"
          }
        },
        {
          "id": "purchase-order-po",
          "source": "Purchase Order / PO",
          "japanese": "PO for an established compact UI abbreviation; 購買発注 when the business document needs to be explicit",
          "notes": "Context decision. Keep PO if part of an identifier or known product label. Do not use two names randomly within one screen.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "Purchase Order",
              "PO"
            ],
            "match": "phrase",
            "severity": "warning"
          }
        },
        {
          "id": "po-confirmation-poc",
          "source": "PO Confirmation / POC",
          "japanese": "POC for an established UI abbreviation; 購買発注確認 for explicit document/process wording",
          "notes": "Context decision. Distinguish a supplier response from approving a PO internally.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "PO Confirmation",
              "POC"
            ],
            "match": "phrase",
            "severity": "warning"
          }
        },
        {
          "id": "verify-verification",
          "source": "Verify / Verification",
          "japanese": "確認 for human/business checking; 検証 for technical correctness; 認証 only for an actual authentication/certification meaning",
          "notes": "Context decision. Inspect the operation, not just the English verb.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "Verify",
              "Verification"
            ],
            "match": "phrase",
            "severity": "warning"
          }
        },
        {
          "id": "verified",
          "source": "Verified",
          "japanese": "確認済み after a human/business check; 検証済み after validating correctness",
          "notes": "Context decision. A manually reviewed extraction is not automatically an authenticated identity.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
