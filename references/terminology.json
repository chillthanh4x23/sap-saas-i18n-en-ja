          "source": "Confirm / Confirmation",
          "japanese": "確認 for checking or accepting a dialog; business compounds may have their own terms",
          "notes": "Do not turn confirmation into approval."
        },
        {
          "id": "approve-approval-approved",
          "source": "Approve / Approval / Approved",
          "japanese": "承認 / 承認 / 承認済み",
          "notes": "Use only where the source really grants approval."
        },
        {
          "id": "item",
          "source": "Item",
          "japanese": "明細 for document line items; 品目 for a material; 項目 for a field/list entry; アイテム only where natural and agreed",
          "notes": "Resolve from namespace/call site. Never globally map Item to 明細.",
          "check": {
            "kind": "context-dependent",
            "sourceTerms": [
              "Item",
              "Items"
